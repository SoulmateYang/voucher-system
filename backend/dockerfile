# 使用官方OpenJDK 17作为基础镜像 [ref_3]
FROM openjdk:17-jre-slim
# 维护者信息
LABEL maintainer="ymh@example.com"
# 在容器内创建一个目录来存放应用
RUN mkdir -p /app
# 将宿主机的JAR文件复制到容器内的/app目录下
COPY target/voucher-system-1.0.0-SNAPSHOT.jar /app/app.jar
# 指定工作目录
WORKDIR /app
# 暴露应用运行的端口（与application.properties中的server.port一致）
EXPOSE 8080
# 定义容器启动时执行的命令
ENTRYPOINT ["java", "-jar", "app.jar"]
